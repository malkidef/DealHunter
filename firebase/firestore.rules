rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil privé : chaque entreprise ne lit et ne modifie que son propre profil.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      match /sellerOffers/{offerId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /buyerNeeds/{needId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Catalogues partagés : visibles uniquement après connexion.
    // Seul le propriétaire d'une annonce peut la créer, modifier ou supprimer.
    match /publicOffers/{offerId} {
      function validOffer() {
        return request.resource.data.keys().hasOnly([
          "ownerUid", "company", "product", "category", "quantity",
          "unitPrice", "location", "status", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid", "company", "product", "category", "quantity",
          "unitPrice", "location", "status", "createdAt"
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.company is string
        && request.resource.data.product is string
        && request.resource.data.category is string
        && request.resource.data.quantity is number
        && request.resource.data.unitPrice is number
        && request.resource.data.location is string
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is timestamp;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validOffer()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validOffer();
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /publicNeeds/{needId} {
      function validNeed() {
        return request.resource.data.keys().hasOnly([
          "ownerUid", "company", "product", "category", "quantity",
          "maxUnitBudget", "location", "status", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid", "company", "product", "category", "quantity",
          "maxUnitBudget", "location", "status", "createdAt"
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.company is string
        && request.resource.data.product is string
        && request.resource.data.category is string
        && request.resource.data.quantity is number
        && request.resource.data.maxUnitBudget is number
        && request.resource.data.location is string
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is timestamp;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validNeed()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validNeed();
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /matchRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "sellerId", "buyerId", "sellerUid", "buyerUid", "participantUids",
          "requesterUid", "recipientUid", "requesterCompany", "recipientCompany",
          "product", "status", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "sellerId", "buyerId", "sellerUid", "buyerUid", "participantUids",
          "requesterUid", "recipientUid", "requesterCompany", "recipientCompany",
          "product", "status", "createdAt"
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.sellerUid is string
        && request.resource.data.buyerUid is string
        && request.resource.data.sellerUid != request.resource.data.buyerUid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAll([
          request.resource.data.sellerUid, request.resource.data.buyerUid
        ])
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.recipientUid in request.resource.data.participantUids
        && request.resource.data.requesterUid in [
          request.resource.data.sellerUid, request.resource.data.buyerUid
        ]
        && request.resource.data.recipientUid in [
          request.resource.data.sellerUid, request.resource.data.buyerUid
        ]
        && request.resource.data.status == "pending"
        && request.resource.data.sellerId is string
        && request.resource.data.buyerId is string
        && request.resource.data.requesterCompany is string
        && request.resource.data.recipientCompany is string
        && request.resource.data.product is string
        && request.resource.data.createdAt is timestamp;
      // Seuls les deux participants peuvent lire une demande.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientUid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "rejected"]
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        // Le destinataire ne peut modifier que la décision et sa date.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
        && request.resource.data.respondedAt is timestamp;
      allow delete: if false;
    }

    // Messagerie privée : uniquement entre participants d'une mise en relation acceptée.
    match /matchMessages/{messageId} {
      function acceptedParticipant(requestId) {
        return exists(/databases/$(database)/documents/matchRequests/$(requestId))
          && get(/databases/$(database)/documents/matchRequests/$(requestId)).data.status == "accepted"
          && request.auth.uid in get(/databases/$(database)/documents/matchRequests/$(requestId)).data.participantUids;
      }
      allow read: if request.auth != null
        && acceptedParticipant(resource.data.requestId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "requestId", "senderUid", "text", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "requestId", "senderUid", "text", "createdAt"
        ])
        && request.resource.data.requestId is string
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && acceptedParticipant(request.resource.data.requestId);
      allow update, delete: if false;
    }

    // Accords commerciaux : seule une mise en relation produit acceptée peut porter une proposition.
    match /deals/{dealId} {
      function acceptedDealRequest() {
        return exists(/databases/$(database)/documents/matchRequests/$(request.resource.data.requestId))
          && get(/databases/$(database)/documents/matchRequests/$(request.resource.data.requestId)).data.status == "accepted"
          && get(/databases/$(database)/documents/matchRequests/$(request.resource.data.requestId)).data.participantUids == request.resource.data.participantUids;
      }
      allow read: if request.auth != null && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "requestId","sellerUid","buyerUid","participantUids","proposerUid","accepterUid",
          "product","quantity","unitPrice","totalAmount","commissionRate","commissionAmount",
          "status","sellerConfirmed","buyerConfirmed","createdAt","updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "requestId","sellerUid","buyerUid","participantUids","proposerUid","accepterUid",
          "product","quantity","unitPrice","totalAmount","commissionRate","commissionAmount",
          "status","sellerConfirmed","buyerConfirmed","createdAt","updatedAt"
        ])
        && request.resource.data.requestId is string
        && request.resource.data.sellerUid is string
        && request.resource.data.buyerUid is string
        && request.resource.data.sellerUid != request.resource.data.buyerUid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAll([request.resource.data.sellerUid,request.resource.data.buyerUid])
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.proposerUid == request.auth.uid
        && request.resource.data.accepterUid in request.resource.data.participantUids
        && request.resource.data.accepterUid != request.auth.uid
        && request.resource.data.product is string
        && request.resource.data.product.size() > 0
        && request.resource.data.product.size() <= 160
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.unitPrice is number
        && request.resource.data.unitPrice > 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount == request.resource.data.quantity * request.resource.data.unitPrice
        && request.resource.data.commissionRate == 5
        && request.resource.data.commissionAmount is number
        && request.resource.data.commissionAmount >= 0
        && request.resource.data.status == "proposed"
        && request.resource.data.sellerConfirmed == false
        && request.resource.data.buyerConfirmed == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && acceptedDealRequest();
      allow update: if request.auth != null && (
        (resource.data.status == "proposed"
          && request.auth.uid == resource.data.accepterUid
          && request.resource.data.status == "agreed"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","agreedAt","updatedAt"])
          && request.resource.data.agreedAt is timestamp
          && request.resource.data.updatedAt is timestamp)
        ||
        (resource.data.status == "agreed"
          && request.auth.uid in resource.data.participantUids
          && ((request.auth.uid == resource.data.sellerUid
              && resource.data.sellerConfirmed == false
              && request.resource.data.sellerConfirmed == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sellerConfirmed","sellerConfirmedAt","status","updatedAt"])
              && request.resource.data.sellerConfirmedAt is timestamp)
            || (request.auth.uid == resource.data.buyerUid
              && resource.data.buyerConfirmed == false
              && request.resource.data.buyerConfirmed == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["buyerConfirmed","buyerConfirmedAt","status","updatedAt"])
              && request.resource.data.buyerConfirmedAt is timestamp))
          && request.resource.data.status == (
            (request.auth.uid == resource.data.sellerUid ? resource.data.buyerConfirmed : resource.data.sellerConfirmed)
              ? "completed" : "agreed")
          && request.resource.data.updatedAt is timestamp)
      );
      allow delete: if false;
    }

    // Avis uniquement après transaction terminée et réservé aux deux participants.
    match /dealReviews/{reviewId} {
      function completedDeal() {
        return exists(/databases/$(database)/documents/deals/$(request.resource.data.dealId))
          && get(/databases/$(database)/documents/deals/$(request.resource.data.dealId)).data.status == "completed"
          && request.auth.uid in get(/databases/$(database)/documents/deals/$(request.resource.data.dealId)).data.participantUids;
      }
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.reviewerUid || request.auth.uid == resource.data.subjectUid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["dealId","reviewerUid","subjectUid","rating","comment","createdAt"])
        && request.resource.data.keys().hasAll(["dealId","reviewerUid","subjectUid","rating","comment","createdAt"])
        && request.resource.data.dealId is string
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.subjectUid is string
        && request.resource.data.subjectUid != request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && request.resource.data.createdAt is timestamp
        && reviewId == request.resource.data.dealId + "_" + request.auth.uid
        && completedDeal()
        && request.resource.data.subjectUid in get(/databases/$(database)/documents/deals/$(request.resource.data.dealId)).data.participantUids;
      allow update, delete: if false;
    }

    match /matchContacts/{contactId} {
      function acceptedRequest(requestId) {
        return exists(/databases/$(database)/documents/matchRequests/$(requestId))
          && get(/databases/$(database)/documents/matchRequests/$(requestId)).data.status == "accepted"
          && request.auth.uid in get(/databases/$(database)/documents/matchRequests/$(requestId)).data.participantUids;
      }
      allow read: if request.auth != null
        && acceptedRequest(resource.data.requestId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "requestId", "ownerUid", "email", "phone", "company", "sharedAt"
        ])
        && request.resource.data.keys().hasAll([
          "requestId", "ownerUid", "email", "phone", "company", "sharedAt"
        ])
        && request.resource.data.requestId is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.company is string
        && request.resource.data.sharedAt is timestamp
        && acceptedRequest(request.resource.data.requestId)
        && contactId == request.resource.data.requestId + "_" + request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "requestId", "ownerUid", "email", "phone", "company", "sharedAt"
        ])
        && request.resource.data.keys().hasAll([
          "requestId", "ownerUid", "email", "phone", "company", "sharedAt"
        ])
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.company is string
        && request.resource.data.sharedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "phone", "company", "sharedAt"
        ])
        && acceptedRequest(resource.data.requestId)
        && contactId == resource.data.requestId + "_" + request.auth.uid;
      allow delete: if false;
    }
    // Catalogues de prestations : informations commerciales uniquement, sans coordonnées.
    // Seul le propriétaire peut créer, modifier ou retirer sa fiche.
    match /publicServiceOffers/{offerId} {
      function validServiceOffer() {
        return request.resource.data.keys().hasOnly([
          "ownerUid", "company", "title", "description", "category", "location",
          "countryCode", "qualifications", "remote", "coverageRadiusKm",
          "requiredQualifications", "remoteAccepted", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid", "company", "title", "description", "category", "location",
          "countryCode", "qualifications", "remote", "coverageRadiusKm",
          "status", "updatedAt"
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.company is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.location is string
        && request.resource.data.countryCode.matches("^[A-Z]{2}$")
        && request.resource.data.qualifications is list
        && request.resource.data.remote is bool
        && request.resource.data.coverageRadiusKm is number
        && request.resource.data.coverageRadiusKm >= 0
        && request.resource.data.coverageRadiusKm <= 5000
        && request.resource.data.status == "active"
        && request.resource.data.updatedAt is timestamp;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && validServiceOffer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid && validServiceOffer()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /publicServiceRequests/{requestId} {
      function validServiceRequest() {
        return request.resource.data.keys().hasOnly([
          "ownerUid", "company", "title", "description", "category", "location",
          "countryCode", "qualifications", "remote", "coverageRadiusKm",
          "requiredQualifications", "remoteAccepted", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid", "company", "title", "description", "category", "location",
          "countryCode", "qualifications", "remote", "coverageRadiusKm",
          "requiredQualifications", "remoteAccepted", "status", "updatedAt"
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.company is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.location is string
        && request.resource.data.countryCode.matches("^[A-Z]{2}$")
        && request.resource.data.qualifications is list
        && request.resource.data.requiredQualifications is list
        && request.resource.data.remote is bool
        && request.resource.data.remoteAccepted is bool
        && request.resource.data.coverageRadiusKm is number
        && request.resource.data.coverageRadiusKm >= 0
        && request.resource.data.coverageRadiusKm <= 5000
        && request.resource.data.status == "active"
        && request.resource.data.updatedAt is timestamp;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && validServiceRequest()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid && validServiceRequest()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Consentement bilatéral pour les mises en relation de prestations.
    match /serviceMatchRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "offerId", "serviceRequestId", "providerUid", "clientUid", "participantUids",
          "requesterUid", "recipientUid", "requesterCompany", "recipientCompany",
          "serviceTitle", "needTitle", "status", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "offerId", "serviceRequestId", "providerUid", "clientUid", "participantUids",
          "requesterUid", "recipientUid", "requesterCompany", "recipientCompany",
          "serviceTitle", "needTitle", "status", "createdAt"
        ])
        && request.resource.data.offerId is string
        && request.resource.data.serviceRequestId is string
        && exists(/databases/$(database)/documents/publicServiceOffers/$(request.resource.data.offerId))
        && exists(/databases/$(database)/documents/publicServiceRequests/$(request.resource.data.serviceRequestId))
        && get(/databases/$(database)/documents/publicServiceOffers/$(request.resource.data.offerId)).data.ownerUid == request.resource.data.providerUid
        && get(/databases/$(database)/documents/publicServiceRequests/$(request.resource.data.serviceRequestId)).data.ownerUid == request.resource.data.clientUid
        && get(/databases/$(database)/documents/publicServiceOffers/$(request.resource.data.offerId)).data.status == "active"
        && get(/databases/$(database)/documents/publicServiceRequests/$(request.resource.data.serviceRequestId)).data.status == "active"
        && request.resource.data.providerUid is string
        && request.resource.data.clientUid is string
        && request.resource.data.providerUid != request.resource.data.clientUid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAll([request.resource.data.providerUid, request.resource.data.clientUid])
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid in request.resource.data.participantUids
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.requesterCompany is string
        && request.resource.data.recipientCompany is string
        && request.resource.data.serviceTitle is string
        && request.resource.data.needTitle is string
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null && request.auth.uid in resource.data.participantUids;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientUid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "rejected"]
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.providerUid == resource.data.providerUid
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
        && request.resource.data.respondedAt is timestamp;
      allow delete: if false;
    }

    // Messagerie de prestations : uniquement après acceptation par les deux entreprises.
    match /serviceMatchMessages/{messageId} {
      function acceptedServiceParticipant(requestId) {
        return exists(/databases/$(database)/documents/serviceMatchRequests/$(requestId))
          && get(/databases/$(database)/documents/serviceMatchRequests/$(requestId)).data.status == "accepted"
          && request.auth.uid in get(/databases/$(database)/documents/serviceMatchRequests/$(requestId)).data.participantUids;
      }
      allow read: if request.auth != null && acceptedServiceParticipant(resource.data.requestId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["requestId","senderUid","text","createdAt"])
        && request.resource.data.keys().hasAll(["requestId","senderUid","text","createdAt"])
        && request.resource.data.requestId is string
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && acceptedServiceParticipant(request.resource.data.requestId);
      allow update, delete: if false;
    }


    // Marché des compétences : profil public volontaire et offres d'emploi/missions.
    // Les catalogues excluent coordonnées privées et attributs sensibles.
    match /publicWorkerProfiles/{profileId} {
      function validWorkerProfile() {
        return request.resource.data.keys().hasOnly([
          "ownerUid","title","category","description","location","countryCode",
          "skills","qualifications","engagementTypes","availableFrom","remote",
          "publicProfileConsent","status","createdAt","updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid","title","category","description","location","countryCode",
          "skills","qualifications","engagementTypes","availableFrom","remote",
          "publicProfileConsent","status","createdAt","updatedAt"
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.location is string
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.matches("^[A-Z]{2}$")
        && request.resource.data.skills is list
        && request.resource.data.qualifications is list
        && request.resource.data.engagementTypes is list
        && request.resource.data.engagementTypes.size() > 0
        && request.resource.data.engagementTypes.hasOnly(["employment","independent"])
        && request.resource.data.availableFrom is string
        && request.resource.data.remote is bool
        && request.resource.data.publicProfileConsent == true
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && validWorkerProfile();
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid && validWorkerProfile();
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /publicWorkOpenings/{openingId} {
      function validWorkOpening() {
        return request.resource.data.keys().hasOnly([
          "ownerUid","company","title","category","description","location","countryCode",
          "requiredSkills","requiredQualifications","engagementType","startDate",
          "remoteAccepted","status","createdAt","updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid","company","title","category","description","location","countryCode",
          "requiredSkills","requiredQualifications","engagementType","startDate",
          "remoteAccepted","status","createdAt","updatedAt"
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.company is string
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.location is string
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.matches("^[A-Z]{2}$")
        && request.resource.data.requiredSkills is list
        && request.resource.data.requiredQualifications is list
        && request.resource.data.engagementType in ["employment","independent"]
        && request.resource.data.startDate is string
        && request.resource.data.remoteAccepted is bool
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && validWorkOpening();
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid && validWorkOpening();
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }


    match /workMatchRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["candidateProfileId","openingId","candidateUid","employerUid","participantUids","requesterUid","recipientUid","engagementType","candidateTitle","openingTitle","status","createdAt"])
        && request.resource.data.keys().hasAll(["candidateProfileId","openingId","candidateUid","employerUid","participantUids","requesterUid","recipientUid","engagementType","candidateTitle","openingTitle","status","createdAt"])
        && exists(/databases/$(database)/documents/publicWorkerProfiles/$(request.resource.data.candidateProfileId))
        && exists(/databases/$(database)/documents/publicWorkOpenings/$(request.resource.data.openingId))
        && get(/databases/$(database)/documents/publicWorkerProfiles/$(request.resource.data.candidateProfileId)).data.ownerUid == request.resource.data.candidateUid
        && get(/databases/$(database)/documents/publicWorkOpenings/$(request.resource.data.openingId)).data.ownerUid == request.resource.data.employerUid
        && get(/databases/$(database)/documents/publicWorkerProfiles/$(request.resource.data.candidateProfileId)).data.status == "active"
        && get(/databases/$(database)/documents/publicWorkerProfiles/$(request.resource.data.candidateProfileId)).data.publicProfileConsent == true
        && get(/databases/$(database)/documents/publicWorkOpenings/$(request.resource.data.openingId)).data.status == "active"
        && request.resource.data.engagementType in ["employment","independent"]
        && request.resource.data.engagementType == get(/databases/$(database)/documents/publicWorkOpenings/$(request.resource.data.openingId)).data.engagementType
        && request.resource.data.engagementType in get(/databases/$(database)/documents/publicWorkerProfiles/$(request.resource.data.candidateProfileId)).data.engagementTypes
        && request.resource.data.candidateTitle == get(/databases/$(database)/documents/publicWorkerProfiles/$(request.resource.data.candidateProfileId)).data.title
        && request.resource.data.openingTitle == get(/databases/$(database)/documents/publicWorkOpenings/$(request.resource.data.openingId)).data.title
        && request.resource.data.candidateUid != request.resource.data.employerUid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAll([request.resource.data.candidateUid,request.resource.data.employerUid])
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid in request.resource.data.participantUids
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == "pending" && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null && request.auth.uid in resource.data.participantUids;
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientUid
        && resource.data.status == "pending" && request.resource.data.status in ["accepted","rejected"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","respondedAt"])
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.candidateUid == resource.data.candidateUid
        && request.resource.data.employerUid == resource.data.employerUid
        && request.resource.data.candidateProfileId == resource.data.candidateProfileId
        && request.resource.data.openingId == resource.data.openingId
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.respondedAt is timestamp;
      allow delete: if false;
    }
    match /workMatchMessages/{messageId} {
      function acceptedWorkParticipant(requestId) {
        return exists(/databases/$(database)/documents/workMatchRequests/$(requestId))
          && get(/databases/$(database)/documents/workMatchRequests/$(requestId)).data.status == "accepted"
          && request.auth.uid in get(/databases/$(database)/documents/workMatchRequests/$(requestId)).data.participantUids;
      }
      allow read: if request.auth != null && acceptedWorkParticipant(resource.data.requestId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["requestId","senderUid","text","createdAt"])
        && request.resource.data.keys().hasAll(["requestId","senderUid","text","createdAt"])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp && acceptedWorkParticipant(request.resource.data.requestId);
      allow update, delete: if false;
    }

    // Vérification manuelle des entreprises et qualifications, sans dépôt de pièces privées.
    match /verificationRequests/{verificationId} {
      function isDealHunterAdmin() {
        return request.auth != null && request.auth.token.dealhunterAdmin == true;
      }
      function validVerificationRequest() {
        return request.resource.data.keys().hasOnly([
          "ownerUid","subjectType","subjectName","countryCode",
          "evidenceLabel","publicEvidenceUrl","status","createdAt","updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "ownerUid","subjectType","subjectName","countryCode",
          "evidenceLabel","publicEvidenceUrl","status","createdAt","updatedAt"
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.subjectType in ["company","qualification"]
        && request.resource.data.subjectName is string
        && request.resource.data.subjectName.size() >= 2
        && request.resource.data.subjectName.size() <= 120
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.matches("^[A-Z]{2}$")
        && request.resource.data.evidenceLabel is string
        && request.resource.data.evidenceLabel.size() >= 2
        && request.resource.data.evidenceLabel.size() <= 160
        && request.resource.data.publicEvidenceUrl is string
        && request.resource.data.publicEvidenceUrl.matches("^https://.*")
        && request.resource.data.publicEvidenceUrl.size() <= 500
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }
      allow create: if request.auth != null && validVerificationRequest();
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isDealHunterAdmin());
      allow update: if request.auth != null && (
        (isDealHunterAdmin()
          && resource.data.status == "pending"
          && request.resource.data.status in ["verified","rejected"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","reviewerNote","reviewedAt"])
          && request.resource.data.reviewedAt is timestamp
          && (!("reviewerNote" in request.resource.data) || (request.resource.data.reviewerNote is string && request.resource.data.reviewerNote.size() <= 500)))
        ||
        (resource.data.ownerUid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "withdrawn"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","updatedAt"])
          && request.resource.data.updatedAt is timestamp)
      );
      allow delete: if false;
    }

    // Signalements de fraude ou d'annonces suspectes, privés par défaut.
    match /trustReports/{reportId} {
      function isTrustAdmin() {
        return request.auth != null && request.auth.token.dealhunterAdmin == true;
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["reporterUid","targetType","targetId","reason","description","status","createdAt"])
        && request.resource.data.keys().hasAll(["reporterUid","targetType","targetId","reason","description","status","createdAt"])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ["company","product_listing","service_listing","work_profile","work_opening","deal"]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 160
        && request.resource.data.reason in ["fraud","counterfeit","misleading","duplicate","unsafe","spam","other"]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null
        && (resource.data.reporterUid == request.auth.uid || isTrustAdmin());
      allow update: if isTrustAdmin()
        && resource.data.status == "pending"
        && request.resource.data.status in ["reviewed","actioned","false_positive"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","reviewerNote","reviewedAt"])
        && request.resource.data.reviewedAt is timestamp
        && (!("reviewerNote" in request.resource.data) || (request.resource.data.reviewerNote is string && request.resource.data.reviewerNote.size() <= 500));
      allow delete: if false;
    }

    // Suggestions de matching : lisibles uniquement par les deux propriétaires.
    // Les écritures restent réservées au moteur serveur (Admin SDK).
    match /matches/{matchId} {
      allow read: if request.auth != null
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;
    }

  }
}